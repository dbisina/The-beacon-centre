{
  "cli": {
    "version": ">= 18.12.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://the-beacon-centre-production.up.railway.app/api"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://the-beacon-centre-production.up.railway.app/api"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
