# Database
# Connect to Supabase via connection pooling
DATABASE_URL="postgresql://postgres.connestionstuf:password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection to the database. Used for migrations
DIRECT_URL="postgresql://postgres.connestionstuf:password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET="beacon-centre-super-secret-jwt-key-change-this-in-production"
JWT_REFRESH_SECRET="beacon-centre-super-secret-refresh-key-change-this-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cloudinary
CLOUDINARY_CLOUD_NAME=xxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDINARY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDINARY_UPLOAD_PRESET=beacon_admin_preset

# CORS - additional allowed origins beyond the built-in dev/prod lists in src/config/cors.ts (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:19006

# Paystack (giving)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# YouTube (admin "Sync from YouTube" bulk-import for video sermons)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Gemini (devotional "Make a card" background image generation, and video
# classification for the YouTube sync above)
# Preferred: comma-separated pool of up to 15 keys, rotated round-robin and
# retried on 429 so one key's rate limit doesn't block the feature.
GEMINI_API_KEYS=
# Fallback if you only have one key - GEMINI_API_KEYS above takes priority.
GEMINI_API_KEY=

# Firebase Admin (verifies end-user ID tokens from the mobile app; project thebeaconcentre-40f9a)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE_MB=100